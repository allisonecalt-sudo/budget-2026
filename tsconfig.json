{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],

    // PHASE 1: loose on purpose — allowJs transpile only, no type-checking of
    // the legacy app.js. Strict mode + the food-log config land in Phase 3
    // once app.js is ported to app.ts.
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["app.ts"],
  "exclude": ["node_modules", "dist", "tests", "playwright.config.js"]
}
